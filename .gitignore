# input data, third-party code and caches: never commit
# (only the placeholder READMEs in datasets/ and external/ are tracked)
/datasets/**
!/datasets/**/
!/datasets/**/README.md
/external/**
!/external/README.md
data_cache/
*.npy
*.npz
*.parquet
*.feather
*.pkl
*.h5
*.xlsx

# environments, caches, OS
.venv/
.env/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
.claude/

# local build outputs
manuscript/*.built.md
manuscript/~$*

# explainer: per-line DepMap values regenerated by docs/explainer/worked_example.py (not distributed)
docs/explainer/data/worked_example_scores_A.tsv
